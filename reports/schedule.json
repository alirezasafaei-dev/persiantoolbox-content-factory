    "0 3 * * * cd /home/dev13/alirezasafaeisystems/sites/persiantoolbox-content-factory && ptb-content qa --report >> /home/dev13/alirezasafaeisystems/sites/persiantoolbox-content-factory/logs/weekly-qa-report.log 2>&1"
  ],
  "log_dir": "/home/dev13/alirezasafaeisystems/sites/persiantoolbox-content-factory/logs",
