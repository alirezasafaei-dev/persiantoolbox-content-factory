{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://persiantoolbox.ir/schemas/catalog-record.json",
  "title": "Catalog Record",
  "description": "A single tool or resource discovered by the crawler",
  "type": "object",
  "required": ["canonical_url", "title", "summary", "category", "source_id", "source_hash", "crawled_at", "risk_tags"],
  "properties": {
    "canonical_url": {"type": "string", "format": "uri"},
    "title": {"type": "string", "minLength": 3},
    "summary": {"type": "string", "minLength": 10},
    "category": {"type": "string", "enum": ["tool-demo", "pdf-tutorial", "persian-text", "professional", "privacy", "financial", "seasonal", "comparison"]},
    "source_id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "source_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "crawled_at": {"type": "string", "format": "date-time"},
    "verified_at": {"type": ["string", "null"], "format": "date-time"},
    "expires_at": {"type": ["string", "null"], "format": "date-time"},
    "claims": {
      "type": "array",
      "items": {"$ref": "#/$defs/Claim"},
      "maxItems": 10
    },
    "risk_tags": {
      "type": "array",
      "items": {"type": "string", "enum": ["financial", "legal", "tax", "security", "privacy", "testimonial", "comparative", "statistical", "medical"]},
      "uniqueItems": true
    },
    "http_metadata": {
      "type": "object",
      "properties": {
        "status_code": {"type": "integer"},
        "content_type": {"type": "string"},
        "content_length": {"type": "integer"},
        "last_modified": {"type": ["string", "null"]},
        "etag": {"type": ["string", "null"]}
      }
    },
    "meta": {
      "type": "object",
      "description": "Extra metadata from crawl (og tags, etc.)",
      "additionalProperties": true
    }
  },
  "$defs": {
    "Claim": {
      "type": "object",
      "required": ["text", "source_id", "verifiable"],
      "properties": {
        "text": {"type": "string", "minLength": 5},
        "source_id": {"type": "string"},
        "verifiable": {"type": "boolean"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1}
      }
    }
  }
}
