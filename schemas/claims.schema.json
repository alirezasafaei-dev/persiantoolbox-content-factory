{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://persiantoolbox.ir/schemas/claims.json",
  "title": "Claims Package",
  "description": "Verifiable claims extracted from a catalog record",
  "type": "object",
  "required": ["brief_id", "source_id", "claims", "generated_at"],
  "properties": {
    "brief_id": {"type": "string"},
    "source_id": {"type": "string"},
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["text", "source_id", "verifiable", "verdict"],
        "properties": {
          "text": {"type": "string"},
          "source_id": {"type": "string"},
          "verifiable": {"type": "boolean"},
          "verdict": {"type": "string", "enum": ["VERIFIED", "UNVERIFIED", "UNVERIFIABLE", "DISPUTED"]},
          "evidence_url": {"type": ["string", "null"]},
          "confidence": {"type": "number"}
        }
      }
    },
    "generated_at": {"type": "string", "format": "date-time"}
  }
}
