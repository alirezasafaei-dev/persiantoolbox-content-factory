{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://persiantoolbox.ir/schemas/approval.json",
  "title": "Approval Record",
  "description": "Human approval record for content publishing",
  "type": "object",
  "required": ["brief_id", "approved", "created_at"],
  "properties": {
    "brief_id": {"type": "string"},
    "approved": {"type": "boolean"},
    "reviewer": {"type": ["string", "null"]},
    "notes": {"type": "string"},
    "conditions": {
      "type": "array",
      "items": {"type": "string"}
    },
    "created_at": {"type": "string", "format": "date-time"}
  }
}
