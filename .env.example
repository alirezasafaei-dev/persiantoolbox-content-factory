# PersianToolbox Content Factory — Environment Variables
# Copy to .env and fill in values. NEVER commit .env to Git.

# --- Meta Instagram API Credentials ---
# BLOCKED: Meta developer verification unavailable (Iran not in supported phone list).
# Semi-automated mode does NOT require these variables.
# Leave empty until verification is resolved.
META_INSTAGRAM_APP_ID=
META_INSTAGRAM_APP_SECRET=
META_INSTAGRAM_ACCESS_TOKEN=
META_INSTAGRAM_ACCOUNT_ID=

# --- Meta API Config ---
# BLOCKED: Only needed when PTB_PUBLISHER=meta-instagram.
# Semi-automated mode does NOT use these.
META_API_VERSION=
META_HOST_URL=

# --- Publish Controls (FAIL-CLOSED defaults) ---
PTB_AUTO_PUBLISH=false
PTB_LIVE_CANARY_APPROVED=false
PTB_GENERATION_ENABLED=true
PTB_SCHEDULER_ENABLED=true
PTB_REAL_PUBLISH_ENABLED=false

# --- Publisher Selection ---
# mock = semi-automated (manual Instagram app posting) — ACTIVE
# meta-instagram = real API (BLOCKED until Meta developer verification)
PTB_PUBLISHER=mock

# --- Rate Limiting ---
PTB_MAX_POSTS_PER_24H=50
PTB_CONTAINER_TIMEOUT=600
PTB_POLL_INTERVAL=10

# --- Media Gateway ---
PTB_MEDIA_GATEWAY_SECRET=
PTB_MEDIA_GATEWAY_TTL_HOURS=24
PTB_MEDIA_GATEWAY_HOST=

# --- Queue ---
PTB_QUEUE_DB=data/publish-queue.db

# --- OAuth ---
PTB_OAUTH_REDIRECT_URI=http://localhost:8080/callback

# --- Semi-Automated Mode ---
# When PTB_PUBLISHER=mock, content is generated/rendered/QA'd automatically
# but publishing requires manual steps:
#   1. ptb-content approve <brief_id>
#   2. ptb-content export-instagram <brief_id>
#   3. Copy bundle files to phone
#   4. Post via Instagram app
#   5. ptb-content manual-scheduled <brief_id> --at <ISO8601>
#   6. ptb-content manual-published <brief_id> --permalink <url>
