# PersianToolbox Content Factory — Environment Variables
# Copy to .env and fill in values. NEVER commit .env to Git.

# --- Meta Instagram API Credentials ---
# Get these from https://developers.facebook.com/apps/
META_INSTAGRAM_APP_ID=
META_INSTAGRAM_APP_SECRET=
META_INSTAGRAM_ACCESS_TOKEN=
META_INSTAGRAM_ACCOUNT_ID=

# --- Meta API Config ---
META_API_VERSION=v21.0
META_HOST_URL=https://graph.facebook.com

# --- Publish Controls (FAIL-CLOSED defaults) ---
# PTB_AUTO_PUBLISH=false          # Enable auto-publishing pipeline
# PTB_LIVE_CANARY_APPROVED=false  # Must be YES for real publishes
# PTB_GENERATION_ENABLED=true     # Content generation on/off
# PTB_SCHEDULER_ENABLED=false     # Cron scheduler on/off
# PTB_REAL_PUBLISH_ENABLED=false  # Meta API publisher on/off

# --- Publisher Selection ---
# PTB_PUBLISHER=mock              # 'mock' or 'meta-instagram'

# --- Rate Limiting ---
# PTB_MAX_POSTS_PER_24H=50        # Max posts per 24h (Instagram limit: 100)
# PTB_CONTAINER_TIMEOUT=600       # Seconds to wait for container processing
# PTB_POLL_INTERVAL=10            # Seconds between container status polls

# --- Media Gateway ---
# PTB_MEDIA_GATEWAY_SECRET=       # HMAC secret for signed URLs
# PTB_MEDIA_GATEWAY_TTL_HOURS=24  # URL expiry in hours
# PTB_MEDIA_GATEWAY_HOST=         # Public URL host (e.g. https://media.persiantoolbox.ir)

# --- Queue ---
# PTB_QUEUE_DB=data/publish-queue.db  # SQLite database path

# --- OAuth ---
# PTB_OAUTH_REDIRECT_URI=http://localhost:8080/callback
